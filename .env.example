# ─── LLM ───
OPENAI_API_KEY=sk-...
MODEL_NAME=gpt-4.1-mini
TEMPERATURE=0.9

# ─── Telegram (推送文案 / 报告) ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── 自动发帖 ───
# mock    -> 写入 outputs/published/ 并发 Telegram（默认）
# webhook -> POST 到 XHS_PUBLISH_WEBHOOK 自托管发布器
XHS_PUBLISHER_BACKEND=mock
XHS_PUBLISH_WEBHOOK=
XHS_PUBLISH_TOKEN=

# ─── 数据库 ───
XHS_DB_PATH=kb/xhs_agent.db

# ─── MCP Server ───
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8765
